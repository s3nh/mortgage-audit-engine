# Copy to .env and fill in, or export these variables directly.
# Any OpenAI-compatible endpoint works (vLLM, LiteLLM, internal gateway, hosted API).

AUDIT_LLM_BASE_URL=http://localhost:8000/v1
AUDIT_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
AUDIT_LLM_API_KEY=EMPTY

# Vision model for process-map images (defaults to the LLM endpoint if unset)
AUDIT_VLM_BASE_URL=http://localhost:8001/v1
AUDIT_VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
AUDIT_VLM_API_KEY=EMPTY
